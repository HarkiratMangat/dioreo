{
  "name": "dioreo",
  "version": "3.84.0-pre",
  "description": "Discord bot for Call of Duty: Mobile — loadouts, lucky draws, CP pricing, patch notes, seasonal calendars, and countdowns.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "check": "find . -name \"*.js\" -not -path \"./node_modules/*\" -not -path \"*/node_modules/*\" -not -path \"./.claude/worktrees/*\" -print0 | xargs -0 -P 8 -n1 node --check",
    "site": "node --check scripts/buildLegalPages.js && node --check scripts/lib/chronicle.js && node --check scripts/lib/commandsPage.js && node --check scripts/lib/commandCatalog.js && node --check scripts/lib/commandProse.js && node scripts/buildLegalPages.js",
    "portal": "node portal/server.js",
    "docs:audit": "node scripts/docs-audit.mjs",
    "handoff": "node scripts/handoffCheck.mjs",
    "tdz": "node scripts/tdzRatchet.mjs",
    "doc:claims": "node scripts/docClaimCheck.mjs",
    "docs:audit:test": "node scripts/testCache.mjs docs-audit-test scripts/docs-audit.mjs scripts/docs-audit.test.mjs scripts/docs-audit-test-parallel.mjs -- node scripts/docs-audit-test-parallel.mjs",
    "test:hooks": "node scripts/testCache.mjs hooks .claude/hooks -- bash .claude/hooks/run-all-tests.sh && bash scripts/hookOutputCap.test.sh",
    "portal:gate": "node docs/superpowers/mockups/2026-08-23-portal-interactive/.schema-gate.mjs --self-test",
    "portal:preflight": "node scripts/portalPreflight.mjs",
    "portal:bust": "node docs/superpowers/mockups/2026-08-23-portal-interactive/.bust.mjs",
    "portal:refs": "node docs/superpowers/mockups/2026-08-23-portal-interactive/.undeclared.mjs --self-test",
    "portal:coverage": "node scripts/portalCoverage.mjs",
    "portal:gapsplit": "node scripts/portalGapSplit.mjs",
    "portal:orphans": "node scripts/portalOrphans.mjs",
    "portal:reverse-orphans": "node scripts/portalReverseOrphans.mjs",
    "portal:openkind": "node scripts/portalOpenKind.mjs",
    "portal:sync": "node scripts/portalSync.mjs",
    "portal:reverse-orphans:test": "node scripts/portalReverseOrphans.test.mjs",
    "portal:geometry": "node scripts/portalGeometry.mjs",
    "portal:geometry:test": "node scripts/portalGeometry.test.mjs",
    "portal:states": "node scripts/portalStates.mjs",
    "portal:states:test": "node scripts/portalStates.test.mjs",
    "portal:status:test": "node scripts/portalStatus.test.mjs",
    "portal:coverage:test": "node scripts/portalCoverage.test.mjs",
    "portal:roundtrip": "node \"docs/superpowers/mockups/2026-08-23-portal-interactive/.roundtrip.mjs\"",
    "test": "node scripts/testRunner.mjs",
    "portal:audit": "node scripts/portalAudit.mjs",
    "docs:reflow": "node scripts/reflow-prose.mjs --check",
    "docs:reflow:test": "node scripts/reflow-prose.test.mjs",
    "docs:reflow-comments": "node scripts/reflow-comments.mjs --check",
    "docs:reflow-comments:test": "node scripts/reflow-comments.test.mjs",
    "portal:diff": "node scripts/portalDiff.mjs",
    "portal:inventory": "node scripts/portalInventory.mjs",
    "portal:converge": "node scripts/portalConverge.mjs",
    "portal:probe": "node scripts/portalProbe.mjs",
    "portal:status": "node scripts/portalStatus.mjs",
    "index:health": "node --no-warnings scripts/indexHealth.mjs",
    "test:tz": "node scripts/tzIndependence.test.mjs",
    "portal:template-comments": "node scripts/portalTemplateComments.mjs",
    "portal:template-comments:test": "node scripts/portalTemplateComments.test.mjs",
    "portal:stylerank:test": "node scripts/portalStyleRank.test.mjs",
    "portal:realwalk": "node scripts/portalRealWalk.mjs",
    "portal:reviewwalk": "node scripts/portalReviewWalk.mjs",
    "portal:realwalk:test": "node scripts/portalRealWalk.test.mjs",
    "autofix:safety": "node scripts/autofixSafety.test.mjs",
    "portal:sweep": "bash scripts/portalSweep.sh",
    "portal:uxcopy": "node scripts/portalUxCopy.mjs",
    "portal:agreement": "node scripts/portalAgreement.mjs",
    "portal:ledger-rows": "node scripts/portalLedgerRows.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "author": "Harkirat Mangat (dior)",
  "license": "LicenseRef-Dioreo-Source-Available-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarkiratMangat/dioreo.git"
  },
  "bugs": {
    "url": "https://github.com/HarkiratMangat/dioreo/issues"
  },
  "homepage": "https://github.com/HarkiratMangat/dioreo#readme",
  "dependencies": {
    "chrono-node": "^2.9.1",
    "cloudinary": "^2.10.0",
    "color-namer": "^1.4.0",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.1",
    "google-auth-library": "^11.0.2",
    "jimp": "^1.6.1",
    "mongoose": "^9.7.3"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "eslint": "^10.9.1",
    "htm": "^3.1.1",
    "linkedom": "^0.18.13",
    "markdown-it": "^15.0.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "puppeteer-core": "^25.8.0",
    "xlsx": "^0.18.5"
  }
}

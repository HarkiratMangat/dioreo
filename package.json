{
  "name": "dioreo",
  "version": "2.53.0",
  "description": "Discord bot for Call of Duty: Mobile — loadouts, lucky draws, CP pricing, patch notes, seasonal calendars, and countdowns.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "check": "find . -name \"*.js\" -not -path \"./node_modules/*\" -print0 | xargs -0 -n1 node --check",
    "site": "node --check scripts/buildLegalPages.js && node --check scripts/lib/chronicle.js && node scripts/buildLegalPages.js",
    "docs:audit": "node scripts/docs-audit.mjs",
    "docs:audit:test": "node scripts/docs-audit.test.mjs",
    "test:hooks": "bash .claude/hooks/run-all-tests.sh",
    "test": "npm run check && npm run docs:audit:test && node scripts/calendarDedup.test.js && npm run test:hooks"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "author": "Harkirat Mangat (dior)",
  "license": "LicenseRef-Dioreo-Source-Available-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarkiratMangat/dioreo.git"
  },
  "bugs": {
    "url": "https://github.com/HarkiratMangat/dioreo/issues"
  },
  "homepage": "https://github.com/HarkiratMangat/dioreo#readme",
  "dependencies": {
    "chrono-node": "^2.9.1",
    "cloudinary": "^2.10.0",
    "color-namer": "^1.4.0",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.1",
    "jimp": "^1.6.1",
    "mongoose": "^9.7.3"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}

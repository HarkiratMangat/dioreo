{
  "addNew": {
    "custom_id": "add_draw_new",
    "title": "Add New Draw",
    "components": [
      {
        "type": 1,
        "components": [
          {
            "type": 4,
            "custom_id": "title",
            "label": "Draw Title",
            "style": 1,
            "required": false
          }
        ]
      },
      {
        "type": 1,
        "components": [
          {
            "type": 4,
            "custom_id": "items",
            "label": "Items (Shorthand)",
            "style": 2,
            "placeholder": "m Character Name\nl Gun Name\ne Emote Name\n-# Optional note",
            "required": false
          }
        ]
      },
      {
        "type": 1,
        "components": [
          {
            "type": 4,
            "custom_id": "date",
            "label": "Release Date",
            "style": 1,
            "placeholder": "e.g. July 15",
            "required": false
          }
        ]
      },
      {
        "type": 1,
        "components": [
          {
            "type": 4,
            "custom_id": "url",
            "label": "Thumbnail URL (blank = reuse cached image)",
            "style": 1,
            "required": false
          }
        ]
      },
      {
        "type": 1,
        "components": [
          {
            "type": 4,
            "custom_id": "combined",
            "label": "Or Paste As One Line (overrides fields above)",
            "style": 2,
            "placeholder": "Title, m Item 1, l Item 2, July 15, url.jpg",
            "required": false
          }
        ]
      }
    ]
  },

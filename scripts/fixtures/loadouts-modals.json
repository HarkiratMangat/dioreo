{
  "addMP": {
    "custom_id": "add_loadout_MP",
    "title": "Create New MP Loadout",
    "components": [
      {
        "type": 18,
        "label": "Weapon name, label",
        "description": "The label is optional and only shown here, e.g. BAL-27, Ranked",
        "component": {
          "type": 4,
          "custom_id": "weapon",
          "style": 1,
          "required": true,
          "max_length": 80,
          "placeholder": "BAL-27, Ranked"
        }
      },
      {
        "type": 18,
        "label": "Category, build #, gunsmith code",
        "description": "The code is required; a build # another build has swaps the two",
        "component": {
          "type": 4,
          "custom_id": "build",
          "style": 1,
          "required": true,
          "max_length": 60,
          "placeholder": "AR, 2, 1C2B4A8B9A"
        }
      },
      {
        "type": 18,
        "label": "Attachments and badges",
        "description": "One attachment per line, then a Badges: line",
        "component": {
          "type": 4,
          "custom_id": "attachments",
          "style": 2,
          "required": true,
          "max_length": 1000,
          "placeholder": "Gauge-9 Mono\nCrown-H3 Barrel\nBadges: meta, top3"
        }
      },
      {
        "type": 18,
        "label": "Image (URL)",
        "description": "Optional. Use this or the screenshot, not both",
        "component": {
          "type": 4,
          "custom_id": "image_url",
          "style": 1,
          "required": false,
          "max_length": 500,
          "placeholder": "https://..."
        }
      },
      {
        "type": 18,
        "label": "Image (screenshot)",
        "description": "Optional. A Gunsmith screenshot of this build",
        "component": {
          "type": 19,
          "custom_id": "image_file",
          "min_values": 0,
          "max_values": 1,
          "required": false
        }
      }
    ]
  },
